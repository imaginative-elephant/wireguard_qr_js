# ==================== Balanced Security + Convenience ====================

# Block very new packages
min-release-age=7

# Disable automatic scripts
ignore-scripts=true

# ==================== Versioning ====================

# Always save exact versions
save-exact=true

# ==================== Registry & Network ====================

registry=https://registry.npmjs.org/
strict-ssl=true

# ==================== Audit ====================

audit=true
audit-level=moderate

# ==================== Performance & UX ====================

prefer-offline=true
progress=true
color=true

# ==================== Others ====================

# Don't automatically fund packages
fund=false
# Prevent git dependencies
allow-git=none
