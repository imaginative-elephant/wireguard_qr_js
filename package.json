{
  "name": "wireguard_qr_js",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css,html}\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "update:safe": "npm update",
    "update:check": "npm outdated",
    "update:minor": "npx npm-check-updates --target minor -u && npm install",
    "update:patch": "npx npm-check-updates --target patch -u && npm install",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "type-check": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml,css,html}": "prettier --write"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@noble/curves": "^2.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "clsx": "^2.1.1",
    "ini": "6.0.0",
    "lucide-react": "^1.14.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "7.75.0",
    "react-hot-toast": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "zod": "4.4.3",
    "zod-validation-error": "5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/ini": "^4.1.1",
    "@types/node": "24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "3.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-sri": "0.0.2",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "glob": "^13.0.6",
    "whatwg-encoding": "@exodus/bytes"
  }
}
